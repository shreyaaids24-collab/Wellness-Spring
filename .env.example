# Environment variables – copy to backend/.env and adjust

# MariaDB connection string (SQLAlchemy + PyMySQL)
# Format: mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/wellness_tracker

# JWT signing secret – change this for any shared/demo environment
SECRET_KEY=replace-with-a-long-random-string

# Optional
DEBUG=true
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
